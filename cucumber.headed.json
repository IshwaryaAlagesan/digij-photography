{
  "default": {
    "paths": ["tests/features/**/*.feature"],
    "require": [
      "tests/support/**/*.js",
      "tests/step-definitions/**/*.js"
    ],
    "format": [
      "progress-bar",
      "html:tests/reports/cucumber-report.html",
      "allure-cucumberjs/reporter"
    ],
    "formatOptions": {
      "resultsDir": "./allure-results"
    },
    "publishQuiet": true,
    "worldParameters": {
      "headless": false
    }
  }
}
